{
  "inbounds": [
    {
      "port": 8080,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": false
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/TG-@Not_Ragnar"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "redirect": "simon.simonfreevps.icu:443"
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "simon.simonfreevps.icu"
        },
        "wsSettings": {
          "path": "/simonfree",
          "headers": {
            "Host": "simon.simonfreevps.icu"
          }
        }
      }
    }
  ]
}
